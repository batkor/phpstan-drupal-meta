parameters:
  PhpStanDrupalMeta:
    dir: '.phpstan.meta'

services:
  PhpStanDrupalMetaMap:
    class: PhpStanDrupalMeta\MetaMap
    arguments:
      parser: @currentPhpVersionSimpleDirectParser
      metaDir: '%PhpStanDrupalMeta.dir%'

  - class: PhpStanDrupalMeta\Rules\Services
    arguments:
      map: @PhpStanDrupalMetaMap
    tags:
      - phpstan.rules.rule

  - class: PhpStanDrupalMeta\Rules\Configurations
    arguments:
      map: @PhpStanDrupalMetaMap
    tags:
      - phpstan.rules.rule

  - class: PhpStanDrupalMeta\Rules\EntityTypes\Storage\CallStorage
    arguments:
      map: @PhpStanDrupalMetaMap
    tags:
      - phpstan.rules.rule

  - class: PhpStanDrupalMeta\Rules\EntityTypes\Storage\CheckStorageMethods
    arguments:
      map: @PhpStanDrupalMetaMap
    tags:
      - phpstan.broker.dynamicMethodReturnTypeExtension

parametersSchema:
  PhpStanDrupalMeta: structure([
    dir: string()
  ])
